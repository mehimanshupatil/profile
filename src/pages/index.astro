---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import AskMe from "@/components/AskMe";
import IndicatorBoard from "@/components/IndicatorBoard.astro";
import LensSwitcher from "@/components/LensSwitcher.astro";
import StationBoard from "@/components/StationBoard.astro";
import { defaultQuestions } from "@/data/lenses";
import { experience, owner, socials } from "@/data/site";
import { answers } from "@/data/answers";
import { projectCards } from "@/lib/answers";
import Base from "@/layouts/Base.astro";
import portrait from "@/assets/portrait.jpg";

const cards = await projectCards();
const projects = (await getCollection("projects", (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
---

<Base home>
	<div class="mx-auto max-w-3xl">
		<section id="intro" class="flex min-h-[calc(100dvh-3.5rem)] flex-col justify-center py-16 lg:min-h-dvh" data-c="Intro">
			<p class="text-line font-mono text-xs font-semibold tracking-[0.12em] uppercase sm:text-sm">
				Western Line · Fast · Churchgate → Borivali
			</p>
			<h1 class="font-heading mt-4 mb-3 text-6xl leading-[0.92] font-bold uppercase sm:text-8xl lg:text-[7.5rem]">{owner.name}</h1>
			<p class="text-xl sm:text-3xl">{owner.headline}, {owner.city}.</p>
			<p class="text-muted-foreground mt-6 max-w-[60ch] text-lg leading-relaxed">{owner.pitch}</p>
		</section>

		<section id="about" class="scroll-mt-20 py-16 lg:scroll-mt-8">
			<StationBoard station="about" />
			<div class="mt-8 grid items-start gap-8 sm:grid-cols-[1fr_12rem]">
				<div class="text-muted-foreground space-y-4 text-lg leading-relaxed" data-c="AboutCopy">
					<p>
						Seven years building production frontends and the backends behind them: React, Next.js and Angular on the front,
						Node and AWS serverless when a feature needs it.
					</p>
					<p>
						I build component systems other engineers (and LLMs) can pick up without asking me, and I care about the last
						10%: the hover state, the reduced-motion path, the frame budget on a cheap phone.
					</p>
				</div>
				<Image
					src={portrait}
					alt={`Portrait of ${owner.name}`}
					widths={[192, 384]}
					sizes="12rem"
					class="w-48 rounded-lg object-cover grayscale-[0.2] sm:w-full"
				/>
			</div>
		</section>

		<section id="work" class="scroll-mt-20 py-16 lg:scroll-mt-8">
			<StationBoard station="work" />
			<ol class="mt-8" data-c="Timeline">
				{
					experience.map((e) => (
						<li class="grid gap-1 border-t py-6 sm:grid-cols-[10rem_1fr] sm:gap-6">
							<time class="text-muted-foreground font-mono text-sm">
								{e.from} – {e.to}
							</time>
							<div>
								<h3 class="text-xl font-semibold">
									{e.role}, {e.org}
								</h3>
								<ul class="text-muted-foreground mt-2 list-disc space-y-1 pl-5 leading-relaxed marker:text-line">
									{e.points.map((p) => <li>{p}</li>)}
								</ul>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<section id="projects" class="scroll-mt-20 py-16 lg:scroll-mt-8">
			<StationBoard station="projects" />
			<div class="mt-8"><IndicatorBoard projects={projects} /></div>
			<a href="/projects/" class="text-line mt-4 inline-block font-mono text-sm font-semibold hover:underline">All projects →</a>
		</section>

		<section id="ask" class="scroll-mt-20 py-16 lg:scroll-mt-8">
			<StationBoard station="ask" />
			<p class="text-muted-foreground mt-6 max-w-[60ch]">The questions recruiters ask most, answered from my CV and projects.</p>
			<div class="mt-8">
				<AskMe client:visible questions={defaultQuestions} answers={answers} projects={cards} />
			</div>
			<div class="mt-10"><LensSwitcher /></div>
		</section>

		<section id="contact" class="scroll-mt-20 py-16 lg:scroll-mt-8">
			<StationBoard station="contact" />
			<p class="mt-8 text-2xl sm:text-3xl">End of the line.</p>
			<a href={`mailto:${owner.email}`} class="text-line font-heading mt-2 inline-block text-4xl font-bold break-all hover:underline sm:text-5xl">
				{owner.email}
			</a>
			<ul class="mt-6 flex flex-wrap gap-4 font-mono text-sm">
				{socials.map((s) => <li><a class="hover:text-line underline-offset-4 hover:underline" href={s.href}>{s.label}</a></li>)}
				<li><a class="hover:text-line underline-offset-4 hover:underline" href={owner.cv}>CV</a></li>
			</ul>
		</section>
	</div>
</Base>
